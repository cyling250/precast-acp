# 统一行尾规范：仓库与检出一律 LF。
# 仓库位于 NTFS 盘、Windows 与 WSL 两端共写：Windows 工具写入的 CRLF
# 在 git 入库比对时会被 clean 过滤器归一为 LF，不再产生"假改动"。
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件：禁止任何行尾/编码转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.tif  binary
*.tiff binary
*.pdf  binary
*.doc  binary
*.docx binary
*.xls  binary
*.xlsx binary
*.ppt  binary
*.pptx binary
*.zip  binary
*.gz   binary
*.tar  binary
*.7z   binary
*.pt   binary
*.pth  binary
*.npy  binary
*.npz  binary
*.h5   binary
*.hdf5 binary
